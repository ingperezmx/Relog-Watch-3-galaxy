<?xml version="1.0" encoding="utf-8"?>
<watchface>
	<metadata key="clock-type" value="com.samsung.watchface-noblesse-a8"/>
	<metadata key="preview_time" value="10:10:42"/>
	<metadata key="model_samsung_health_save_values_to_pref" value="true"/>

	<groups>
		<!-- 1. Fondo Laberinto PAC-MAN Arcade Retro -->
		<group name="bg" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_bg.png"/>
			</part>
			<!-- Toque en pasos para Samsung Health -->
			<action on_event="tap" type="launch" privilege="http://tizen.org/privilege/healthinfo">
				<launch preset="pedometer"/>
			</action>
		</group>

		<!-- 2. Manecillas y PAC-MAN Animado a 60 FPS -->
		<group name="hands" x="0" y="0" width="360" height="360">
			<!-- Manecilla Horaria Blanca Arcade -->
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_hand_hour.png"/>
				<rotation center_x="180" center_y="180" start_angle="0" end_angle="360" start_value="0" end_value="12" source="hour0-11.minute"/>
			</part>

			<!-- Manecilla Minutera Naranja/Roja Arcade -->
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_hand_min.png"/>
				<rotation center_x="180" center_y="180" start_angle="0" end_angle="360" start_value="0" end_value="60" source="minute.second"/>
			</part>

			<!-- PAC-MAN Animado en el Circuito Exterior a 60 fps (Segundero) -->
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_hand_sec.png"/>
				<rotation center_x="180" center_y="180" start_angle="0" end_angle="360" start_value="0" end_value="60" source="second.millisecond" animation="sweep60s"/>
			</part>

			<!-- Capuchón Central Dorado -->
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_pivot.png"/>
			</part>

			<!-- Toque central para Calendario -->
			<action on_event="tap" type="launch">
				<launch preset="event"/>
			</action>
		</group>
	</groups>

	<!-- Modo Siempre Encendido (AOD / Ambient): Laberinto Minimalista y Manecillas sobre Negro Puro AMOLED -->
	<groups type="ambient-fullcolor">
		<!-- Fondo Negro Puro AMOLED (Píxeles 100% apagados) -->
		<group name="aod-bg" x="0" y="0" width="360" height="360" hide_when_transparent_background="true">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_bg_aod.png"/>
			</part>
		</group>

		<!-- Manecillas en AOD -->
		<group name="aod-hands" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_hand_hour.png"/>
				<rotation center_x="180" center_y="180" start_angle="0" end_angle="360" start_value="0" end_value="12" source="hour0-11.minute"/>
			</part>

			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_hand_min.png"/>
				<rotation center_x="180" center_y="180" start_angle="0" end_angle="360" start_value="0" end_value="60" source="minute"/>
			</part>

			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a8/pacman_pivot.png"/>
			</part>
		</group>
	</groups>
</watchface>
