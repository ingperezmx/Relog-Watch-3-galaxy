<?xml version="1.0" encoding="utf-8"?>
<watchface>
	<metadata key="clock-type" value="com.samsung.watchface-noblesse-a5"/>
	<metadata key="preview_time" value="10:10:35"/>
	<metadata key="model_samsung_health_save_values_to_pref" value="true"/>

	<!-- Audio disabled for zero battery drain -->

	<groups>
		<!-- 1. Background Dial: Authentic Vintage Casio 205 Gold & Black Dial -->
		<group name="bg" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a5/casio_bg.png"/>
			</part>
		</group>

		<!-- 2. Date Sub-Box (Upper Right of LCD) -->
		<group name="comp-date" x="245" y="127" width="28" height="28">
			<part type="text" x="0" y="2" width="28" height="24">
				<font code="AT10603"/>
				<color code="#12181c100%"/>
				<text align="center"><icu-skeleton english_number="true">d</icu-skeleton></text>
			</part>
			<action on_event="tap" type="launch"><launch preset="event"/></action>
		</group>

		<!-- 3. Seconds Sub-Box (Below Date in LCD) -->
		<group name="comp-seconds" x="245" y="159" width="28" height="28">
			<part type="text" x="0" y="2" width="28" height="24">
				<font code="AT10603"/>
				<color code="#12181c100%"/>
				<text align="center"><icu-skeleton english_number="true">ss</icu-skeleton></text>
			</part>
			<action on_event="tap" type="launch"><launch preset="stopwatch"/></action>
		</group>

		<!-- 4. Main Digital Time LCD: Large 7-Segment Numbers (HH:mm / hh:mm) -->
		<group name="comp-main-time" x="90" y="142" width="152" height="54">
			<part type="text" x="0" y="0" width="152" height="54">
				<font code="AT10101"/>
				<color code="#12181c100%"/>
				<text align="center">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="alarm"/></action>
		</group>

		<!-- 5. Battery Level (Lower Left Compartment, next to bolt icon) -->
		<group name="comp-battery" x="118" y="204" width="56" height="30">
			<part type="text" x="0" y="2" width="56" height="26">
				<font code="AT10603"/>
				<color code="#12181c100%"/>
				<text align="center"><format source="battery.percent"/>%</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="battery"/></action>
		</group>

		<!-- 6. Steps Counter (Lower Right Compartment, top row next to shoe icon) -->
		<group name="comp-steps" x="206" y="202" width="64" height="16">
			<part type="text" x="0" y="0" width="64" height="16">
				<font code="AT10605"/>
				<color code="#12181c100%"/>
				<text align="right"><format source="pedometer.step"/></text>
			</part>
			<action on_event="tap" type="launch"><launch preset="pedometer"/></action>
		</group>

		<!-- 7. Heart Rate BPM (Lower Right Compartment, bottom row next to heart icon) -->
		<group name="comp-heart-rate" x="206" y="219" width="64" height="16">
			<part type="text" x="0" y="0" width="64" height="16">
				<font code="AT10605"/>
				<color code="#12181c100%"/>
				<text align="right"><format source="heartrate.rate"/></text>
			</part>
			<action on_event="tap" type="launch"><launch preset="heartrate"/></action>
		</group>
	</groups>

	<!-- Ambient Always-On Display (AOD) Mode: Ultra-low power Pure AMOLED -->
	<groups type="ambient-fullcolor">
		<!-- 1. Ambient Background -->
		<group name="aod-bg" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a5/casio_bg_aod.png"/>
			</part>
		</group>

		<!-- 2. Ambient Date -->
		<group name="aod-date" x="245" y="127" width="28" height="28">
			<part type="text" x="0" y="2" width="28" height="24">
				<font code="AT10603"/>
				<color code="#dcd8c8100%"/>
				<text align="center"><icu-skeleton english_number="true">d</icu-skeleton></text>
			</part>
		</group>

		<!-- 3. Ambient Digital Time -->
		<group name="aod-time" x="90" y="142" width="152" height="54">
			<part type="text" x="0" y="0" width="152" height="54">
				<font code="AT10101"/>
				<color code="#dcd8c8100%"/>
				<text align="center">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
		</group>

		<!-- 4. Ambient Battery -->
		<group name="aod-battery" x="118" y="204" width="56" height="30">
			<part type="text" x="0" y="2" width="56" height="26">
				<font code="AT10603"/>
				<color code="#dcd8c8100%"/>
				<text align="center"><format source="battery.percent"/>%</text>
			</part>
		</group>

		<!-- 5. Ambient Steps -->
		<group name="aod-steps" x="206" y="202" width="64" height="16">
			<part type="text" x="0" y="0" width="64" height="16">
				<font code="AT10605"/>
				<color code="#dcd8c8100%"/>
				<text align="right"><format source="pedometer.step"/></text>
			</part>
		</group>
	</groups>
</watchface>
