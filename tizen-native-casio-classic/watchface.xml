<?xml version="1.0" encoding="utf-8"?>
<watchface>
	<metadata key="clock-type" value="com.samsung.watchface-noblesse-a5"/>
	<metadata key="preview_time" value="10:10:35"/>
	<metadata key="model_samsung_health_save_values_to_pref" value="true"/>

	<!-- Audio disabled for zero battery drain -->

	<groups>
		<!-- 1. Background Dial: High-Res Casio 206 LCD Dial with CASIO Logo & WR Badge -->
		<group name="bg" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a5/casio_bg.png"/>
			</part>
		</group>

		<!-- 2. Upper LCD Row: Day of Week (WED), Date (10.28), and Battery (%) -->
		<group name="comp-upper-row" x="66" y="98" width="228" height="36">
			<!-- Day of Week -->
			<part type="text" x="4" y="6" width="68" height="24">
				<font code="AT10603"/>
				<color code="#101820100%"/>
				<text align="left"><upper><icu-skeleton english_number="true">EEE</icu-skeleton></upper></text>
			</part>
			<!-- Date (d.M) -->
			<part type="text" x="76" y="6" width="76" height="24">
				<font code="AT10603"/>
				<color code="#101820100%"/>
				<text align="center"><icu-skeleton english_number="true">d.M</icu-skeleton></text>
			</part>
			<!-- Battery Level -->
			<part type="text" x="156" y="6" width="68" height="24">
				<font code="AT10603"/>
				<color code="#101820100%"/>
				<text align="right"><format source="battery.percent"/>%</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="event"/></action>
		</group>

		<!-- 3. Main Digital Time LCD: Large 7-Segment Numbers + Seconds -->
		<group name="comp-main-time" x="64" y="140" width="232" height="62">
			<!-- Hours & Minutes (HH:mm / hh:mm) -->
			<part type="text" x="2" y="2" width="168" height="58">
				<font code="AT10101"/>
				<color code="#0c1218100%"/>
				<text align="left">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
			<!-- Seconds (ss) -->
			<part type="text" x="174" y="16" width="54" height="36">
				<font code="AT10602"/>
				<color code="#0c1218100%"/>
				<text align="left"><icu-skeleton english_number="true">ss</icu-skeleton></text>
			</part>
			<action on_event="tap" type="launch"><launch preset="alarm"/></action>
		</group>

		<!-- 4. Lower LCD Row: Year & Steps Counter -->
		<group name="comp-lower-row" x="66" y="206" width="228" height="38">
			<!-- Year -->
			<part type="text" x="4" y="8" width="80" height="24">
				<font code="AT10603"/>
				<color code="#101820100%"/>
				<text align="left"><icu-skeleton english_number="true">yyyy</icu-skeleton></text>
			</part>
			<!-- Steps Count -->
			<part type="text" x="90" y="8" width="134" height="24">
				<font code="AT10603"/>
				<color code="#101820100%"/>
				<text align="right"><format source="pedometer.step"/> STP</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="pedometer"/></action>
		</group>
	</groups>

	<!-- Ambient Always-On Display (AOD) Mode: Ultra-low power Pure AMOLED -->
	<groups type="ambient-fullcolor">
		<!-- 1. Ambient Background -->
		<group name="aod-bg" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a5/casio_bg_aod.png"/>
			</part>
		</group>

		<!-- 2. Ambient Upper Date -->
		<group name="aod-upper" x="66" y="98" width="228" height="36">
			<part type="text" x="4" y="6" width="68" height="24">
				<font code="AT10603"/>
				<color code="#90a0a8100%"/>
				<text align="left"><upper><icu-skeleton english_number="true">EEE</icu-skeleton></upper></text>
			</part>
			<part type="text" x="76" y="6" width="76" height="24">
				<font code="AT10603"/>
				<color code="#90a0a8100%"/>
				<text align="center"><icu-skeleton english_number="true">d.M</icu-skeleton></text>
			</part>
			<part type="text" x="156" y="6" width="68" height="24">
				<font code="AT10603"/>
				<color code="#90a0a8100%"/>
				<text align="right"><format source="battery.percent"/>%</text>
			</part>
		</group>

		<!-- 3. Ambient Digital Time -->
		<group name="aod-time" x="64" y="140" width="232" height="62">
			<part type="text" x="2" y="2" width="228" height="58">
				<font code="AT10101"/>
				<color code="#d0e0e8100%"/>
				<text align="center">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
		</group>

		<!-- 4. Ambient Steps -->
		<group name="aod-lower" x="66" y="206" width="228" height="38">
			<part type="text" x="4" y="8" width="80" height="24">
				<font code="AT10603"/>
				<color code="#90a0a8100%"/>
				<text align="left"><icu-skeleton english_number="true">yyyy</icu-skeleton></text>
			</part>
			<part type="text" x="90" y="8" width="134" height="24">
				<font code="AT10603"/>
				<color code="#90a0a8100%"/>
				<text align="right"><format source="pedometer.step"/> STP</text>
			</part>
		</group>
	</groups>
</watchface>
