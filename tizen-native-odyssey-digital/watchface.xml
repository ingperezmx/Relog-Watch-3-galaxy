<?xml version="1.0" encoding="utf-8"?>
<watchface>
	<metadata key="clock-type" value="com.samsung.watchface-noblesse-a4"/>
	<metadata key="preview_time" value="10:08:32"/>
	<metadata key="model_samsung_health_save_values_to_pref" value="true"/>

	<!-- Audio disabled for zero-battery drain -->

	<groups>
		<!-- 1. Background Dial: Pure Black OLED Dial, Header, Weather Triangles, Fitness Box & Battery Bar -->
		<group name="bg" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a4/odyssey_bg.png"/>
			</part>
		</group>

		<!-- 2. Weather Row: Sun Icon + Current Temp + Low/High Indicators -->
		<group name="comp-weather" x="80" y="56" width="200" height="28">
			<part type="image" x="4" y="2" width="22" height="22">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a4/odyssey_ic_weather.png"/>
			</part>
			<part type="text" x="28" y="2" width="36" height="22">
				<font code="AT10603"/>
				<color code="#ffffff100%"/>
				<text align="center"><format source="weather.currentTemperature"/>°</text>
			</part>
			<part type="text" x="78" y="2" width="34" height="22">
				<font code="AT10603"/>
				<color code="#ffffff100%"/>
				<text align="center">18°</text>
			</part>
			<part type="text" x="142" y="2" width="34" height="22">
				<font code="AT10603"/>
				<color code="#ffffff100%"/>
				<text align="center">30°</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="weather"/></action>
		</group>

		<!-- 3. Main Digital Time: Big Bold Numerals -->
		<group name="comp-time" x="40" y="82" width="280" height="84">
			<part type="text" x="0" y="4" width="280" height="76">
				<font code="AT10101"/>
				<color code="#ffffff100%"/>
				<text align="center">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="alarm"/></action>
		</group>

		<!-- 4. Date & Seconds Row: SATURDAY [28/06] SEC 32 -->
		<group name="comp-date-row" x="46" y="170" width="268" height="30">
			<!-- Day Name -->
			<part type="text" x="0" y="4" width="102" height="22">
				<font code="AT10603"/>
				<color code="#ffffff100%"/>
				<text align="center"><upper><icu-skeleton english_number="true">EEEE</icu-skeleton></upper></text>
			</part>
			<!-- Neon Yellow Date Badge -->
			<part type="image" x="108" y="2" width="52" height="24">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a4/odyssey_badge.png"/>
			</part>
			<!-- Date inside badge -->
			<part type="text" x="108" y="4" width="52" height="22">
				<font code="AT10603"/>
				<color code="#0c101a100%"/>
				<text align="center"><icu-skeleton english_number="true">d/M</icu-skeleton></text>
			</part>
			<!-- SEC Label -->
			<part type="text" x="166" y="4" width="36" height="22">
				<font code="AT10603"/>
				<color code="#ffffff100%"/>
				<text align="center">SEC</text>
			</part>
			<!-- Dynamic Seconds in Neon Yellow -->
			<part type="text" x="204" y="2" width="40" height="24">
				<font code="AT10602"/>
				<color code="#e6ff00100%"/>
				<text align="center"><icu-skeleton english_number="true">ss</icu-skeleton></text>
			</part>
			<action on_event="tap" type="launch"><launch preset="event"/></action>
		</group>

		<!-- 5. Moon Phase Realistic Sphere -->
		<group name="comp-moon" x="52" y="214" width="48" height="48">
			<part type="image" x="0" y="0" width="48" height="48">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a4/odyssey_moon.png"/>
			</part>
			<action on_event="tap" type="launch"><launch preset="event"/></action>
		</group>

		<!-- 6. Fitness Card: Calorie, Heart Rate, Distance -->
		<group name="comp-fitness-card" x="104" y="214" width="202" height="54">
			<!-- Calorie Active Value -->
			<part type="text" x="78" y="5" width="40" height="20">
				<font code="AT10603"/>
				<color code="#ffffff100%"/>
				<text align="left"><format source="pedometer.activeKiloCalorie"/></text>
			</part>
			<!-- Distance Value -->
			<part type="text" x="120" y="5" width="74" height="20">
				<font code="AT10603"/>
				<color code="#ffffff100%"/>
				<text align="right"><format expr="true"><expr><![CDATA[ Math.round(_[pedometer.distance]/100)/10 ]]></expr></format> KM</text>
			</part>
			<!-- Heart Rate Value -->
			<part type="text" x="64" y="29" width="40" height="20">
				<font code="AT10603"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<condition expr="true">
						<exprs>
							<expr name="show_hr"><![CDATA[ _[privacylock.isLocked] == 0 && _[heartrate.recent] != 0 ]]></expr>
						</exprs>
						<compare expr="show_hr">
							<format source="heartrate.recent"/>
						</compare>
						<default>58</default>
					</condition>
				</text>
			</part>
			<action on_event="tap" type="launch" privilege="http://tizen.org/privilege/healthinfo">
				<launch preset="shealth"/>
			</action>
		</group>

		<!-- 7. Power Row: Battery Percentage Text in Neon Yellow -->
		<group name="comp-power-row" x="50" y="280" width="260" height="24">
			<part type="text" x="160" y="2" width="54" height="20">
				<font code="AT10603"/>
				<color code="#e6ff00100%"/>
				<text align="left"><format source="battery.percent"/>%</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="battery"/></action>
		</group>

		<!-- 8. Steps Row: Runner Icon + Pedometer Steps -->
		<group name="comp-steps-row" x="136" y="308" width="120" height="24">
			<part type="image" x="4" y="3" width="18" height="18">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a4/odyssey_ic_runner.png"/>
			</part>
			<part type="text" x="28" y="2" width="80" height="20">
				<font code="AT10602"/>
				<color code="#ffffff100%"/>
				<text align="left"><format source="pedometer.step"/></text>
			</part>
			<action on_event="tap" type="launch"><launch preset="pedometer"/></action>
		</group>
	</groups>

	<!-- Ambient Always-On Display (AOD) Mode -->
	<groups type="ambient-fullcolor">
		<group name="aod-bg" x="0" y="0" width="360" height="360" hide_when_transparent_background="true">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a4/odyssey_bg_aod.png"/>
			</part>
		</group>

		<!-- AOD Digital Time (Clean White/Dim Font) -->
		<group name="aod-time" x="40" y="82" width="280" height="84">
			<part type="text" x="0" y="4" width="280" height="76">
				<font code="AT10101"/>
				<color code="#dedede100%"/>
				<text align="center">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
		</group>

		<!-- AOD Date -->
		<group name="aod-date" x="40" y="170" width="280" height="30">
			<part type="text" x="0" y="4" width="280" height="22">
				<font code="AT10603"/>
				<color code="#888890100%"/>
				<text align="center">
					<upper><icu-skeleton english_number="true">EEEE</icu-skeleton></upper> <icu-skeleton english_number="true">d/M</icu-skeleton>
				</text>
			</part>
		</group>

		<!-- AOD Battery Level -->
		<group name="aod-batt" x="70" y="280" width="220" height="24">
			<part type="text" x="0" y="2" width="220" height="20">
				<font code="AT10603"/>
				<color code="#888890100%"/>
				<text align="center">POWER <format source="battery.percent"/>%</text>
			</part>
		</group>
	</groups>
</watchface>
