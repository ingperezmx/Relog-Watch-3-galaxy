<?xml version="1.0" encoding="utf-8"?>
<watchface schema_version="0.1" name="Terminal" width="360" height="360">
	<metadata key="clock-type" value="com.samsung.watchface-noblesse-u1"/>
	<metadata key="preview_time" value="12:56:53"/>
	<metadata key="model_samsung_health_save_values_to_pref" value="true"/>
	<groups>
		<!-- 1. Pure AMOLED Pitch Black Background -->
		<group name="bg" x="0" y="0" width="360" height="360">
			<part type="background" x="0" y="0" width="360" height="360">
				<color r="0" g="0" b="0" a="255"/>
			</part>
		</group>

		<!-- 2. Terminal Header: sudo@watch: ~ $ now -->
		<group name="prompt" x="0" y="0" width="360" height="360">
			<part type="text" x="0" y="56" width="360" height="26">
				<font code="AT10603"/>
				<color code="#888888100%"/>
				<text align="center">sudo@watch: ~ $ now</text>
			</part>
		</group>

		<!-- 3. Line [date] -->
		<group name="line-date" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="96" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">[date]</text>
			</part>
			<part type="text" x="138" y="96" width="195" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<icu-skeleton locale="en_US" english_number="true" best_pattern="1">EEE, MMM d</icu-skeleton>
				</text>
			</part>
			<action on_event="tap" type="launch">
				<launch preset="event"/>
			</action>
		</group>

		<!-- 4. Line [time] -->
		<group name="line-time" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="136" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">[time]</text>
			</part>
			<part type="text" x="138" y="136" width="205" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH:mm:ss</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh:mm:ss a</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
		</group>

		<!-- 5. Line [batt] -->
		<group name="line-battery" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="176" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">[batt]</text>
			</part>
			<part type="text" x="138" y="176" width="195" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<format source="battery.percent"/>%
				</text>
			</part>
			<action on_event="tap" type="launch">
				<launch preset="battery"/>
			</action>
		</group>

		<!-- 6. Line [temp] -->
		<group name="line-temp" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="216" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">[temp]</text>
			</part>
			<part type="text" x="138" y="216" width="195" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<condition source="weather.currentTemperature">
						<compare ge="999">--°</compare>
						<default>
							<format source="weather.currentTemperature"/>°
						</default>
					</condition>
				</text>
			</part>
			<action on_event="tap" type="launch">
				<launch preset="weather"/>
			</action>
		</group>

		<!-- 7. Line [hr] -->
		<group name="line-hr" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="256" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">[hr]</text>
			</part>
			<part type="text" x="138" y="256" width="195" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<condition source="heartrate.recent">
						<compare ne="0">
							<format source="heartrate.recent"/> bpm
						</compare>
						<default>-- bpm</default>
					</condition>
				</text>
			</part>
			<action on_event="tap" type="launch">
				<launch preset="heartrate"/>
			</action>
		</group>
	</groups>

	<!-- Ambient Always-On Display (AOD) Mode -->
	<groups type="ambient-fullcolor">
		<group name="ambient-bg" x="0" y="0" width="360" height="360" hide_when_transparent_background="true">
			<part type="background" x="0" y="0" width="360" height="360">
				<color r="0" g="0" b="0" a="255"/>
			</part>
		</group>

		<group name="ambient-prompt" x="0" y="0" width="360" height="360">
			<part type="text" x="0" y="56" width="360" height="26">
				<font code="AT10603"/>
				<color code="#555555100%"/>
				<text align="center">sudo@watch: ~ $ now</text>
			</part>
		</group>

		<group name="ambient-date" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="96" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#666666100%"/>
				<text align="left">[date]</text>
			</part>
			<part type="text" x="138" y="96" width="195" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<icu-skeleton locale="en_US" english_number="true" best_pattern="1">EEE, MMM d</icu-skeleton>
				</text>
			</part>
		</group>

		<group name="ambient-time" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="136" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#666666100%"/>
				<text align="left">[time]</text>
			</part>
			<part type="text" x="138" y="136" width="205" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH:mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh:mm a</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
		</group>

		<group name="ambient-battery" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="176" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#666666100%"/>
				<text align="left">[batt]</text>
			</part>
			<part type="text" x="138" y="176" width="195" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<format source="battery.percent"/>%
				</text>
			</part>
		</group>

		<group name="ambient-temp" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="216" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#666666100%"/>
				<text align="left">[temp]</text>
			</part>
			<part type="text" x="138" y="216" width="195" height="38">
				<font code="A1T0232"/>
				<color code="#ffffff100%"/>
				<text align="left">
					<condition source="weather.currentTemperature">
						<compare ge="999">--°</compare>
						<default>
							<format source="weather.currentTemperature"/>°
						</default>
					</condition>
				</text>
			</part>
		</group>

		<group name="ambient-hr" x="0" y="0" width="360" height="360">
			<part type="text" x="26" y="256" width="105" height="38">
				<font code="A1T0232"/>
				<color code="#666666100%"/>
				<text align="left">[hr]</text>
			</part>
			<part type="text" x="138" y="256" width="195" height="38">
				<font code="A1T0232"/>
				<color code="#888888100%"/>
				<text align="left">
					<condition source="heartrate.recent">
						<compare ne="0">
							<format source="heartrate.recent"/> bpm
						</compare>
						<default>-- bpm</default>
					</condition>
				</text>
			</part>
		</group>
	</groups>
</watchface>
