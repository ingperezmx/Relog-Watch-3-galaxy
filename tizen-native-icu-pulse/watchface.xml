<?xml version="1.0" encoding="utf-8"?>
<watchface>
	<metadata key="clock-type" value="com.samsung.watchface-noblesse-a2"/>
	<metadata key="preview_time" value="10:10:42"/>
	<metadata key="model_samsung_health_save_values_to_pref" value="true"/>

	<!-- Audio disabled for zero battery drain -->

	<groups>
		<!-- 1. Background Dial: High-Res Medical ICU CRT Monitor Grid & Bezels -->
		<group name="bg" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a2/icu_bg.png"/>
			</part>
		</group>

		<!-- 2. Date Status Row (Top Bar) -->
		<group name="comp-date" x="80" y="38" width="200" height="28">
			<part type="text" x="0" y="2" width="200" height="24">
				<font code="AT10603"/>
				<color code="#a0a7a1100%"/>
				<text align="center"><upper><icu-skeleton english_number="true">EEE d MMM</icu-skeleton></upper></text>
			</part>
			<action on_event="tap" type="launch"><launch preset="event"/></action>
		</group>

		<!-- 3. Main Digital Time: High-Contrast Phosphor Green CRT Digits -->
		<group name="comp-time" x="70" y="74" width="220" height="48">
			<part type="text" x="0" y="2" width="220" height="44">
				<font code="AT10101"/>
				<color code="#39ff88100%"/>
				<text align="center">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="alarm"/></action>
		</group>

		<!-- 4. Oscilloscope ECG Animated Pulse Beam (Linear 2.0s continuous sweep) -->
		<group name="comp-ecg-beam" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a2/icu_pulse_beam.png"/>
				<transform type="rotate">
					<rotate period="4.0" mode="linear" direction="cw"/>
				</transform>
			</part>
		</group>

		<!-- 5. Outer Bezel Seconds Dot (Smooth 60-Second Rotation) -->
		<group name="comp-sec-dot" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a2/icu_sec_dot.png"/>
				<transform type="rotate">
					<rotate source="second.millisecond" direction="cw"/>
				</transform>
			</part>
		</group>

		<!-- 6. Heart Rate Monitor: Heart Icon + Live BPM in Medical Coral Red -->
		<group name="comp-heartrate" x="110" y="212" width="140" height="32">
			<!-- Heart Icon -->
			<part type="image" x="16" y="4" width="22" height="22">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a2/icu_ic_heart.png"/>
			</part>
			<!-- Heart Rate Numeric BPM -->
			<part type="text" x="42" y="2" width="80" height="26">
				<font code="AT10602"/>
				<color code="#ff4f5e100%"/>
				<text align="left">
					<condition expr="true">
						<exprs>
							<expr name="show_hr"><![CDATA[ _[privacylock.isLocked] == 0 && _[heartrate.recent] != 0 ]]></expr>
						</exprs>
						<compare expr="show_hr">
							<format source="heartrate.recent"/>
						</compare>
						<default>72</default>
					</condition>
					<span color="#ff4f5e80%"> BPM</span>
				</text>
			</part>
			<action on_event="tap" type="launch" privilege="http://tizen.org/privilege/healthinfo">
				<launch preset="shealth"/>
			</action>
		</group>

		<!-- 7. Bottom Stats: Battery (%) & Pedometer Steps -->
		<group name="comp-bottom-stats" x="60" y="266" width="240" height="26">
			<!-- Battery Level in Phosphor Green -->
			<part type="text" x="10" y="2" width="100" height="22">
				<font code="AT10603"/>
				<color code="#39ff88100%"/>
				<text align="left">BAT <format source="battery.percent"/>%</text>
			</part>
			<!-- Steps Count in Phosphor Gray -->
			<part type="text" x="130" y="2" width="100" height="22">
				<font code="AT10603"/>
				<color code="#a0a7a1100%"/>
				<text align="right"><format source="pedometer.step"/> STP</text>
			</part>
			<action on_event="tap" type="launch"><launch preset="battery"/></action>
		</group>
	</groups>

	<!-- Ambient Always-On Display (AOD) Mode: Ultra-low power Pure AMOLED -->
	<groups type="ambient-fullcolor">
		<!-- 1. Ambient Background -->
		<group name="aod-bg" x="0" y="0" width="360" height="360">
			<part type="image" x="0" y="0" width="360" height="360">
				<image filepath="../../../../../../../../../../opt/usr/home/owner/apps_rw/.shared/com.samsung.watchface/data/watchlist/com.samsung.watchface-noblesse-a2/icu_bg_aod.png"/>
			</part>
		</group>

		<!-- 2. Ambient Date -->
		<group name="aod-date" x="80" y="44" width="200" height="26">
			<part type="text" x="0" y="2" width="200" height="22">
				<font code="AT10603"/>
				<color code="#707771100%"/>
				<text align="center"><upper><icu-skeleton english_number="true">EEE d MMM</icu-skeleton></upper></text>
			</part>
		</group>

		<!-- 3. Ambient Digital Time -->
		<group name="aod-time" x="70" y="80" width="220" height="48">
			<part type="text" x="0" y="2" width="220" height="44">
				<font code="AT10101"/>
				<color code="#2abe65100%"/>
				<text align="center">
					<condition source="is24hour">
						<compare eq="1">
							<icu-skeleton english_number="true">HH</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</compare>
						<default>
							<icu-skeleton english_number="true">hh</icu-skeleton>:<icu-skeleton english_number="true">mm</icu-skeleton>
						</default>
					</condition>
				</text>
			</part>
		</group>

		<!-- 4. Ambient Battery & Steps -->
		<group name="aod-stats" x="60" y="266" width="240" height="26">
			<part type="text" x="10" y="2" width="100" height="22">
				<font code="AT10603"/>
				<color code="#2abe65100%"/>
				<text align="left">BAT <format source="battery.percent"/>%</text>
			</part>
			<part type="text" x="130" y="2" width="100" height="22">
				<font code="AT10603"/>
				<color code="#707771100%"/>
				<text align="right"><format source="pedometer.step"/> STP</text>
			</part>
		</group>
	</groups>
</watchface>
